{
  "name": "juan-portfolio",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run redirects && cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=4096' next build",
    "vercel-build": "npm run build",
    "dev": "npm run redirects && cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && npm run build && npm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "npm install",
    "import:posts": "tsx -r dotenv/config src/scripts/syncContent.ts push",
    "sync": "tsx -r dotenv/config src/scripts/syncContent.ts",
    "sync:keywords": "tsx -r dotenv/config src/scripts/syncKeywords.ts",
    "populate:keywords": "tsx -r dotenv/config src/scripts/populate-keywords.ts",
    "audit:keywords": "tsx -r dotenv/config src/scripts/audit-keywords.ts",
    "audit:urls": "tsx -r dotenv/config src/scripts/audit-urls.ts",
    "sync:gsc": "tsx -r dotenv/config src/scripts/seo/sync-gsc.ts",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "redirects": "tsx -r dotenv/config src/scripts/fetch-redirects.ts",
    "reinstall": "rm -rf node_modules && rm pnpm-lock.yaml && npm install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "fix:links": "tsx src/scripts/fix-internal-links.ts",
    "utils": "tsx -r dotenv/config src/scripts/utils/tui.ts",
    "create-post": "tsx -r dotenv/config src/scripts/create-post.ts",
    "scrape:dinorank": "tsx -r dotenv/config src/scripts/scrape-dinorank.ts",
    "export:keywords": "tsx src/scripts/export-keywords-csv.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-s3": "^3.1026.0",
    "@clack/prompts": "^1.0.1",
    "@google/generative-ai": "^0.24.1",
    "@next/third-parties": "^16.1.6",
    "@nouance/payload-dashboard-analytics": "^0.3.0",
    "@payloadcms/admin-bar": "3.61.1",
    "@payloadcms/db-mongodb": "3.61.1",
    "@payloadcms/email-resend": "3.61.1",
    "@payloadcms/live-preview-react": "3.61.1",
    "@payloadcms/next": "3.61.1",
    "@payloadcms/payload-cloud": "3.61.1",
    "@payloadcms/plugin-form-builder": "3.61.1",
    "@payloadcms/plugin-mcp": "3.61.1",
    "@payloadcms/plugin-nested-docs": "3.61.1",
    "@payloadcms/plugin-redirects": "3.61.1",
    "@payloadcms/plugin-search": "3.61.1",
    "@payloadcms/plugin-seo": "3.61.1",
    "@payloadcms/richtext-lexical": "3.61.1",
    "@payloadcms/storage-vercel-blob": "3.61.1",
    "@payloadcms/translations": "3.61.1",
    "@payloadcms/ui": "3.61.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@splidejs/react-splide": "^0.7.12",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.2.0",
    "@xenova/transformers": "^2.17.2",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "17.2.3",
    "enquirer": "^2.4.1",
    "framer-motion": "^12.29.2",
    "geist": "^1.5.1",
    "glob": "^13.0.6",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0",
    "graphql": "^16.8.2",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.17",
    "lexical": "0.35.0",
    "linkinator": "^7.5.3",
    "lucide-react": "^0.548.0",
    "marked": "^17.0.1",
    "mongodb": "6.16.0",
    "mongoose": "^8.15.1",
    "natural": "^8.1.0",
    "next": "15.2.8",
    "next-sitemap": "^4.2.3",
    "openai": "^6.25.0",
    "p-limit": "^7.3.0",
    "payload": "3.61.1",
    "pluralize": "^8.0.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.65.0",
    "react-turnstile": "^1.1.5",
    "recharts": "^3.7.0",
    "resend": "^6.9.2",
    "sass": "^1.93.2",
    "schema-dts": "^1.1.5",
    "sharp": "0.34.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/glob": "^9.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/natural": "^6.0.1",
    "@types/node": "^24.9.1",
    "@types/pluralize": "^0.0.33",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "5.1.0",
    "@vitest/coverage-v8": "4.0.3",
    "autoprefixer": "^10.4.21",
    "critters": "^0.0.25",
    "eslint": "^9.38.0",
    "eslint-config-next": "15.2.3",
    "jsdom": "27.0.1",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "^20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "@modelcontextprotocol/sdk": "1.25.3"
      }
    }
  },
  "browserslist": [
    "since 2023",
    "not dead"
  ]
}
