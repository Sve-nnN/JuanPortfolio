{
  "buildCommand": "pnpm install --frozen-lockfile && pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "nodeVersion": "20.x",
  "env": {
    "NODE_OPTIONS": "--no-deprecation --max-old-space-size=4096"
  },
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": "/api/admin"
    }
  ]
}
